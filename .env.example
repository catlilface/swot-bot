# ===== swot-bot конфигурация (копируйте в .env) =====

# --- Telegram (bot) ---
BOT_TOKEN=
ADMIN_ID=12345678
TARGET_CHAT_ID=-1001234567890

# --- Broker ---
RABBIT_URL=amqp://guest:guest@rabbitmq:5672/

# --- Пути (общие volume) ---
MEDIA_DIR=/data/media
ARTIFACTS_DIR=/data/artifacts

# --- Downloader ---
# Пусто = любые ссылки (yandex disk, google drive, vk, rutube, прямые файлы и т.д.)
ALLOWED_SOURCES=
MAX_VIDEO_DURATION_SEC=7200

# --- Transcriber (faster-whisper, GPU) ---
WHISPER_MODEL=distil-large-v3
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=int8_float16
WHISPER_LANGUAGE=
WHISPER_BATCH_SIZE=4
WHISPER_MODELS_DIR=/data/models

# --- LLM (OpenAI-совместимый endpoint) ---
OPENAI_COMPATIBLE_API_URL=https://api.openai.com/v1
OPENAI_COMPATIBLE_API_KEY=
LLM_MODEL_ID=gpt-4o-mini
LLM_TEMPERATURE=0.3
PROMPT_NAME=lecture-summary

# --- Langfuse (self-hosted) ---
LANGFUSE_BASE_URL=http://langfuse:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- Observability ---
LOG_LEVEL=INFO
HEALTH_PORT=8080

# --- Жизненный цикл ---
ARTIFACTS_RETENTION_HOURS=168
