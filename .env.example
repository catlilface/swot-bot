# ===== swot-bot конфигурация (копируйте в .env) =====
#
# Общий Settings (contracts.config):
#   - скалярные поля читаются из переменных напрямую (MEDIA_DIR, ARTIFACTS_DIR, HEALTH_PORT);
#   - поднастройки читаются из переменных SECTION__FIELD (разделитель "__").
#
# Три стека (каждый читает этот же .env; `environment` в compose перекрывает .env):
#
#   docker-compose.dev.yml   — тестовый режим: фэйки (Telegram/ASR/LLM) + self-hosted
#                              Langfuse. Реальные ключи НЕ нужны, работает из коробки.
#                              (CI: compose-integration джоб прогоняет именно его.)
#   docker-compose.slim.yml  — минимальный: 4 сервиса + RabbitMQ. Telegram/ASR/LLM —
#                              ВНЕШНИЕ: заполните TELEGRAM__*/TRANSCRIBER__*/LLM__*
#                              своими реальными провайдерами.
#   docker-compose.full.yml  — slim + свои ASR (whisper-server) и LLM (ollama) в стеке.
#                              Эндпоинты ASR/LLM заданы в compose; модели выбираются
#                              переменными ASR_MODEL / LLM_OLLAMA_MODEL ниже.
#                              От вас нужен только реальный TELEGRAM__*.
#
# Переход на реальные сервисы (slim/full):
#   - Telegram: TELEGRAM__TOKEN=<token от BotFather>, TELEGRAM__API_BASE_URL= (пусто),
#     TELEGRAM__ADMIN_ID / TELEGRAM__TARGET_CHAT_ID — реальные id.
#   - LLM: LLM__API_URL / LLM__API_KEY / LLM__MODEL_ID (slim) — full использует ollama.
#   - ASR: TRANSCRIBER__API_URL / TRANSCRIBER__API_KEY / TRANSCRIBER__MODEL (slim) —
#     full использует whisper-server.
#   - Langfuse: поднять self-hosted (v3: postgres+clickhouse+minio, см. README),
#     затем LANGFUSE__HOST / __PUBLIC_KEY / __SECRET_KEY. Пустые ключи = аналитик
#     работает на локальном промпте (fallback, T-0.4).

# --- Пути (общие volume) ---
MEDIA_DIR=/data
ARTIFACTS_DIR=/artifacts

# --- Observability ---
HEALTH_PORT=8080

# --- Telegram (bot) ---
# Dev: синтаксически валидный фиктивный токен + stub (fake-tg).
# Для реального бота: токен BotFather и TELEGRAM__API_BASE_URL= (пусто).
TELEGRAM__TOKEN=123456:AAFakeDevTokenForSwotBot
TELEGRAM__ADMIN_ID=12345678
TELEGRAM__TARGET_CHAT_ID=12345678
TELEGRAM__API_BASE_URL=http://fake-tg:8081

# --- Broker (RabbitMQ; совпадает с RABBIT_USER/RABBIT_PASSWORD в compose) ---
# guest из коробки не подходит: он ограничен loopback'ом (audit P0-5).
BROKER__HOST=rabbitmq
BROKER__PORT=5672
BROKER__USER=swot
BROKER__PASSWORD=swot

# --- Downloader ---
# Пусто = любые ссылки (rutube, disk.yandex.ru, vk, прямые файлы и т.д.)
DOWNLOADER__ALLOWED_SOURCES=
DOWNLOADER__MAX_VIDEO_DURATION_SEC=7200
# Жёсткий дедлайн одного скачивания (фаза yt-dlp); превышение -> JobFailed
DOWNLOADER__DOWNLOAD_TIMEOUT_SEC=300
# Макс. размер файла по прямой HTTP-ссылке (МБ); превышение -> прерывание
DOWNLOADER__MAX_FILE_MB=1024
DOWNLOADER__RETENTION_HOURS=168
# Reaper: задача без финального статуса дольше N часов -> JobFailed("timeout")
DOWNLOADER__JOB_TIMEOUT_HOURS=6

# --- Transcriber (OpenAI-совместимый ASR endpoint) ---
# Dev: фэйк (asr-service в compose, задан в docker-compose.dev.yml).
# Full: whisper-server (также задан в compose; модель = ASR_MODEL ниже).
# Slim: внешний ASR — URL вида http://host:port/v1.
TRANSCRIBER__API_URL=http://asr-service:8000/v1
TRANSCRIBER__API_KEY=none
TRANSCRIBER__MODEL=fake-asr
TRANSCRIBER__LANGUAGE=ru
TRANSCRIBER__SEGMENT_DURATION_SEC=600
TRANSCRIBER__MAX_AUDIO_MB=512
TRANSCRIBER__ASR_TIMEOUT_SEC=300
# Формат ответа ASR: "json" — макс. совместимость (OpenAI, OpenRouter, whisper-server);
# "verbose_json" — сегменты с таймкодами в SRT, но не все эндпоинты поддерживают.
TRANSCRIBER__RESPONSE_FORMAT=json

# --- LLM (OpenAI-совместимый endpoint) ---
# Dev: фэйк (llm-service в compose, задан в docker-compose.dev.yml).
# Full: ollama (также задан в compose; модель = LLM_OLLAMA_MODEL ниже).
# Slim: внешний LLM — URL вида http://host:port/v1.
LLM__API_URL=http://llm-service:8000/v1
LLM__API_KEY=none
LLM__MODEL_ID=fake-chat
LLM__SAMPLING_PARAMETERS='{"temperature": 0.3}'
LLM__SUMMARIZATION_PROMPT_NAME=lecture-summary
LLM__MAX_TOKENS=4096
LLM__TIMEOUT_SEC=120
LLM__CHUNK_CHARS=8000
LLM__MAX_TRANSCRIPT_CHARS=200000

# --- Полностек (docker-compose.full.yml) ---
# Модель whisper-server: tiny / base / small / medium / large-v3-turbo
# (скачивается из HuggingFace при первом старте)
ASR_MODEL=small
# cpu (по умолчанию) | cuda — для cuda также ASR_IMAGE_TAG=cuda
ASR_DEVICE=cpu
# Тег образа hwdsl2/whisper-server: latest (по умолчанию) | cuda
ASR_IMAGE_TAG=
# Модель ollama, любая из https://ollama.com/library (скачивается при первом старте)
LLM_OLLAMA_MODEL=qwen2.5:7b

# --- Langfuse (optional; пустые ключи = локальный промпт, см. T-0.4) ---
LANGFUSE__HOST=langfuse
LANGFUSE__PORT=3000
LANGFUSE__PUBLIC_KEY=
LANGFUSE__SECRET_KEY=
